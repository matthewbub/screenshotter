{
  "name": "screenshotter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "bin": {
    "screenshotter": "./bin/screenshotter.mjs"
  },
  "scripts": {
    "postinstall": "node scripts/setup-local-bin.mjs",
